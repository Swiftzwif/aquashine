# AquaShine Pool Services - Environment Variables Template

# Stripe Keys (Get these from https://dashboard.stripe.com/test/apikeys)
# Use TEST keys for development, LIVE keys for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL (change to production URL when deploying)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Analytics (add when ready)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
